# Kopieer dit bestand naar .env en vul je eigen sleutels in.
# .env staat in .gitignore en komt nooit in de repo.

# Claude (verplicht): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ElevenLabs (optioneel, voor de Britse butlerstem): https://elevenlabs.io/app/settings/api-keys
# Zonder sleutel gebruikt Jarvis de stemmen van macOS (bijv. "Daniel", Brits).
ELEVENLABS_API_KEY=

# Poort van de lokale server
PORT=8765
