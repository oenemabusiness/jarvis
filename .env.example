# Jarvis gebruikt standaard Claude Code met je Claude-abonnement (Pro/Max).
# Dan hoef je hier niets in te vullen.

# Optioneel: ElevenLabs-sleutel voor de echte Britse butlerstem.
# Leeg laten kan: dan gebruikt Jarvis de Mac-stem "Daniel".
ELEVENLABS_API_KEY=

# Alleen als je liever per gebruik betaalt via een API-sleutel:
# zet JARVIS_BRAIN=api en plak je sleutel achter ANTHROPIC_API_KEY=
JARVIS_BRAIN=
ANTHROPIC_API_KEY=

PORT=8765
